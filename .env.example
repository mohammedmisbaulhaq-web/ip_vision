# ipVision — Environment Configuration Template
# Copy this file to .env for local development or enter these in Vercel Project Settings.
# NEVER commit the actual .env file or your private keys to Git!

PORT=3000
ENVIRONMENT=development

# Supabase Auth & Database (From your Supabase Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Secret key used for signing session tokens and anti-CSRF checks
SESSION_SECRET=create-a-random-secure-secret-phrase-at-least-32-chars

# Resend Email Configuration (Optional - secondary email option)
RESEND_API_KEY=re_your_resend_api_key_here
FEEDBACK_FROM_EMAIL=scanner-feedback@yourdomain.com

# Gmail SMTP (Primary feedback delivery to mohammadmisbaulhaq03@gmail.com)
# Step 1: Enable 2-Factor Auth on your Gmail account
# Step 2: Go to Google Account -> Security -> App Passwords -> create one for "ipVision"
# Step 3: Enter your Gmail address and the 16-character App Password below
GMAIL_FROM=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
